%%=============================================================================
%%  Academic paper template — developeruche.com
%%
%%  Rendered by pandoc:  pandoc paper.md --template=paper.latex ...
%%  Placeholders written with dollar-delimiters are pandoc template
%%  variables, NOT LaTeX math. A literal dollar sign must be doubled.
%%
%%  Design notes
%%  ------------
%%  Single column, generous margins, Computer Modern text: the conventional
%%  look for a technical report, and the most readable setting when the PDF is
%%  embedded in a web page at partial width. Set entirely in black, with no
%%  running head and no rules around the abstract.
%%=============================================================================
\documentclass[11pt,a4paper]{article}

\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[left=1.15in,right=1.15in,top=1.1in,bottom=1.15in]{geometry}

%% ── Type ────────────────────────────────────────────────────────────────
%% Computer Modern, the default TeX family, matching the reference exemplar.
%% Latin Modern is the same design with proper outlines, so it renders cleanly
%% on screen and extracts as real text.
\usepackage{lmodern}
\usepackage{microtype}          % optical margins + subtle tracking

%% ── Colour ──────────────────────────────────────────────────────────────
\usepackage{xcolor}
%% The paper is set entirely in black: no accent colour, no grey secondary
%% text, no coloured links. `ink', `accent' and `muted' are kept as names so
%% the rest of the template needs no rewriting, but all three are black now.
\definecolor{ink}{gray}{0}
\definecolor{accent}{gray}{0}
\definecolor{muted}{gray}{0}
\definecolor{rule}{gray}{0}
\definecolor{codebg}{HTML}{F2F2F2}   % code block ground (a tint, not text)
\color{black}

%% ── Links ───────────────────────────────────────────────────────────────
\usepackage[unicode]{hyperref}
\usepackage{xurl}               % allow URLs to break anywhere (no overfull)
\hypersetup{
  hidelinks,                    % clickable, but black and unboxed
  breaklinks=true,
  pdftitle={$if(title-meta)$$title-meta$$else$$title$$endif$},
  pdfauthor={$for(author)$$author$$sep$, $endfor$},
  pdfsubject={$if(subtitle)$$subtitle$$endif$},
  pdfcreator={pandoc + pdflatex}
}

%% ── Sectioning ──────────────────────────────────────────────────────────
\usepackage{titlesec}
\titleformat{\section}{\normalfont\large\bfseries\color{ink}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries\color{ink}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape\color{ink}}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.6em plus .3em minus .2em}{0.7em}
\titlespacing*{\subsection}{0pt}{1.2em plus .2em minus .2em}{0.5em}
\titlespacing*{\subsubsection}{0pt}{1.0em plus .2em minus .2em}{0.4em}
\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth$$else$3$endif$}

%% ── Page style ──────────────────────────────────────────────────────────
%% No running head and no header rule: just a centred page number, as in the
%% reference exemplar.
\pagestyle{plain}

%% ── Lists, spacing ──────────────────────────────────────────────────────
\usepackage{enumitem}
\setlist{itemsep=2pt, parsep=0pt, topsep=4pt, partopsep=0pt}
\setlist[itemize]{label=\textcolor{accent}{\textbullet}}
\linespread{1.06}
\setlength{\parskip}{0pt}
\setlength{\parindent}{1.2em}
\raggedbottom

%% ── Tables / figures ────────────────────────────────────────────────────
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{graphicx}
\usepackage{calc}
\usepackage[font=small,labelfont=bf,labelsep=period]{caption}
\setlength{\emergencystretch}{3em}   % last resort against overfull lines
\providecommand{\tightlist}{%
  \setlength{\itemsep}{1pt}\setlength{\parskip}{0pt}}

% Keep oversized images inside the text block.
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}

%% ── Code ────────────────────────────────────────────────────────────────
%% pandoc emits Shaded/Highlighting; fvextra gives us wrapping so long
%% assembly/Rust lines never bleed into the margin.
\usepackage{fancyvrb}
\usepackage{fvextra}
\usepackage{framed}
\usepackage{upquote}
\definecolor{shadecolor}{named}{codebg}
\setlength{\fboxsep}{5pt}
% Inline \texttt{} at a hair under body size so it doesn't tower over serif text.
\let\oldtexttt\texttt
\renewcommand{\texttt}[1]{{\small\oldtexttt{#1}}}

$if(highlighting-macros)$
$highlighting-macros$
$endif$

%% pandoc's highlighting macros define Highlighting/Shaded themselves, so these
%% overrides MUST come after them or they are silently discarded.
%%   - Highlighting: wrap long lines instead of letting them run off the page.
%%     Assembly comment columns and Rust generics are both wider than the text
%%     block, and an unwrapped Verbatim clips without any warning.
%%   - Shaded: pandoc leaves this empty; snugshade paints the code ground.
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{%
  commandchars=\\\{\},
  fontsize=\scriptsize,
  breaklines=true, breakanywhere=true,
  breakindent=1.2em,
  breaksymbolleft={}, breaksymbolright={\tiny\textcolor{muted}{\ensuremath{\hookleftarrow}}}%
}
\renewenvironment{Shaded}{\begin{snugshade}}{\end{snugshade}}

%% ── Block quotes ────────────────────────────────────────────────────────
\usepackage{etoolbox}
\AtBeginEnvironment{quote}{\small\color{muted}}

%% ── Title block ─────────────────────────────────────────────────────────
\usepackage{titling}
\setlength{\droptitle}{-2.4em}
\pretitle{\begin{center}\LARGE\bfseries}
\posttitle{\end{center}\vspace{0.15em}}
\preauthor{\begin{center}\normalsize}
\postauthor{\end{center}}
\predate{\begin{center}\footnotesize}
\postdate{\end{center}}

\title{$title$$if(subtitle)$\\[0.45em]{\large\mdseries $subtitle$}$endif$}
\author{$for(author)$$author$$sep$ \\ $endfor$$if(author-note)$\\[0.25em]{\footnotesize $author-note$}$endif$}
\date{$if(date)$$date$$endif$}

\begin{document}

\maketitle
\thispagestyle{plain}

$if(abstract)$
\vspace{0.8em}
\begin{center}
\begin{minipage}{0.86\textwidth}
  {\centering\normalsize\bfseries Abstract\par}
  \vspace{0.7em}
  {\small $abstract$\par}
\end{minipage}
\end{center}
\vspace{0.6em}
$endif$

%% Title and abstract stand alone; everything else starts on a fresh page.
\newpage

$if(toc)$
\setcounter{tocdepth}{$if(toc-depth)$$toc-depth$$else$2$endif$}
\tableofcontents
\vspace{1em}
$endif$

$body$

\end{document}
